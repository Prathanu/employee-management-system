<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EMS Smoke Test Suite" verbose="1" parallel="false">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.company.ems.listeners.AllureEnvironmentListener"/>
    </listeners>

    <test name="Smoke Tests">
        <classes>
            <class name="com.company.ems.tests.ApiSmokeTest"/>
            <class name="com.company.ems.tests.LoginSmokeTest"/>
            <class name="com.company.ems.tests.DashboardSmokeTest"/>
            <class name="com.company.ems.tests.EmployeeSmokeTest"/>
        </classes>
    </test>
</suite>
