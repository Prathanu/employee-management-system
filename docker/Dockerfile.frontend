# =============================================================================
# FRONTEND DOCKERFILE — React Employee Management UI (Nginx)
# =============================================================================
# Build context: repository root (c:\Devops)
# Build command:
#   docker build -f docker/Dockerfile.frontend -t ems-frontend:latest .
# =============================================================================

# ── STAGE 1: BUILD ────────────────────────────────────────────────────────────
# Use Node.js to install dependencies and build production React bundle
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files first — caches npm install layer
COPY frontend/package.json frontend/package-lock.json ./

# Clean install from lock file (reproducible builds)
RUN npm ci --silent

# Copy frontend source
COPY frontend/ .

# Build-time API URL — nginx will proxy /api to backend in production
# /api means same-origin requests (no CORS issues in production)
ARG VITE_API_BASE_URL=/api
ARG VITE_USE_MOCK=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_USE_MOCK=$VITE_USE_MOCK

# Build optimized production bundle → /app/dist
RUN npm run build

# ── STAGE 2: RUNTIME ──────────────────────────────────────────────────────────
# Use Nginx to serve static files — lightweight and production-proven
FROM nginx:1.25-alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config (SPA routing + API proxy)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built React app from build stage
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
